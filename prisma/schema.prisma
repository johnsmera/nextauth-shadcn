datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserGoogle {
  id        Int      @id @default(autoincrement())
  userId    String
  googleId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
